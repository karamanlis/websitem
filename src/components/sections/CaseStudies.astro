---
import { getCollection } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";
import Badge from "../ui/Badge.astro";

/**
 * Vaka analizleri yalnızca gerçek müşteri verisiyle yayına çıkar.
 * Koleksiyon boşken bu bölüm sayfada hiç render edilmez — uydurma vakayla
 * site yayına çıkmaz. Gerçek vaka geldiğinde `src/content/case-studies/`
 * altına bir .md dosyası eklemek yeterli; bölüm kendiliğinden geri gelir.
 */
const cases = (await getCollection("case-studies")).sort(
  (a, b) => a.data.order - b.data.order
);
---

{
  cases.length > 0 && (
    <section id="vaka-analizleri" class="section-shell">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div class="aurora left-1/2 top-[8%] h-[440px] w-[720px] -translate-x-1/2 bg-primary-600/20" />
        <div class="noise-layer" />
      </div>

      <div class="section-body mx-auto max-w-6xl px-24 py-64 lg:px-32 lg:py-96">
        <SectionHeading
          eyebrow="Vaka Analizleri"
          title="Sistemin pratikte nasıl çalıştığı."
        />

        <div class="mt-48 grid gap-24 lg:grid-cols-3">
          {cases.map((item) => (
            <article
              data-reveal
              class="glass card-lift card-spotlight flex flex-col gap-24 rounded-2xl p-32"
            >
              {item.data.isPlaceholder && (
                <Badge>Örnek vaka — gerçek verilerle güncellenecek</Badge>
              )}

              <div>
                <p class="font-display text-lg font-semibold text-neutral-50">
                  {item.data.client}
                </p>
                <p class="mt-8 text-xs font-semibold uppercase tracking-[0.12em] text-accent-300">
                  {item.data.industry}
                </p>
              </div>

              <div aria-hidden="true" class="hairline opacity-60" />

              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-500">
                  Problem
                </p>
                <p class="mt-8 text-sm leading-relaxed text-neutral-300">
                  {item.data.problem}
                </p>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-500">
                  Çözüm
                </p>
                <p class="mt-8 text-sm leading-relaxed text-neutral-300">
                  {item.data.solution}
                </p>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-500">
                  Sonuç
                </p>
                <p class="mt-8 text-sm leading-relaxed text-neutral-300">
                  {item.data.results}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
