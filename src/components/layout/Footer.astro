---
import { getDict } from "../../lib/i18n";
import { siteConfig } from "../../lib/site-config";

/* Dil, URL'den çözülür (BaseLayout'tan prop'a gerek yok). */
const { nav, tagline, footer: t } = getDict(Astro.url.pathname);

const year = new Date().getFullYear();
---

{/*
  Footer, Final CTA'nın koyu gradyanını kesmeden devam ettirir: sert bir
  üst kenarlık yerine kenarlara doğru sönümlenen gradyan saç teli ve
  alttan yükselen yumuşak bir yeşil glow kullanır.
*/}
<footer class="section-shell text-neutral-300">
  <div aria-hidden="true" class="hairline"></div>

  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent,rgba(5,12,9,0.85))]"></div>
    <div
      class="aurora left-1/2 bottom-[-40%] h-[420px] w-[820px] -translate-x-1/2 bg-primary-600/22"
    >
    </div>
    <div class="noise-layer"></div>
  </div>

  <div class="section-body mx-auto max-w-6xl px-24 py-64 lg:px-32">
    <div class="grid gap-48 lg:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="flex items-center gap-16 font-display text-xl font-semibold text-neutral-50">
          <span
            aria-hidden="true"
            class="h-32 w-32 shrink-0 rounded-full bg-[linear-gradient(140deg,var(--color-primary-400),var(--color-primary-700))] shadow-[0_0_20px_-4px_rgba(47,128,96,0.8)] ring-1 ring-neutral-50/15"
          >
          </span>
          {siteConfig.name}
        </p>
        <p class="mt-24 max-w-sm text-sm leading-relaxed text-neutral-400">
          {tagline}
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-300">
          {t.site}
        </p>
        <ul class="mt-24 flex flex-col gap-16">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-neutral-400 transition-colors duration-300 ease-premium hover:text-neutral-50"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-300">
          {t.contact}
        </p>
        <ul class="mt-24 flex flex-col gap-16 text-sm text-neutral-400">
          {
            siteConfig.contactEmail && (
              <li>
                <a
                  href={`mailto:${siteConfig.contactEmail}`}
                  class="transition-colors duration-300 ease-premium hover:text-neutral-50"
                >
                  {siteConfig.contactEmail}
                </a>
              </li>
            )
          }
          {
            siteConfig.contactPhone && (
              <li>
                <a
                  href={`tel:${siteConfig.contactPhone.replace(/\s/g, "")}`}
                  class="transition-colors duration-300 ease-premium hover:text-neutral-50"
                >
                  {siteConfig.contactPhone}
                </a>
              </li>
            )
          }
          {
            siteConfig.whatsappNumber && (
              <li>
                <a
                  href={`https://wa.me/${siteConfig.whatsappNumber}`}
                  class="transition-colors duration-300 ease-premium hover:text-neutral-50"
                  rel="noopener"
                >
                  {t.whatsapp}
                </a>
              </li>
            )
          }
          <li>
            <a
              href={t.contactFormHref}
              class="transition-colors duration-300 ease-premium hover:text-neutral-50"
              >{t.contactForm}</a
            >
          </li>
          <li>
            <a
              href={t.privacyHref}
              class="transition-colors duration-300 ease-premium hover:text-neutral-50"
              >{t.privacy}</a
            >
          </li>
        </ul>

        <div class="mt-24 flex items-center gap-16">
          <a
            href="https://www.linkedin.com/in/emre-cenk-2425a3218/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-neutral-400 transition-colors duration-300 ease-premium hover:text-neutral-50"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-24 w-24" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
          </a>
          <a
            href="https://www.instagram.com/dijitalemr?vrfl=MWJpNjNsb3Q0bGtoaw%3D%3D&utm_source=qr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-neutral-400 transition-colors duration-300 ease-premium hover:text-neutral-50"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-24 w-24" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-64">
      <div aria-hidden="true" class="hairline opacity-50"></div>
      <p class="pt-24 text-xs text-neutral-500">
        &copy; {year} {siteConfig.name}. {t.rights}
      </p>
    </div>
  </div>
</footer>
