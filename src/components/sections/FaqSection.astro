---
import SectionHeading from "../ui/SectionHeading.astro";
import { getDict, getLocale, localeTags } from "../../lib/i18n";

const t = getDict(Astro.url.pathname);
const faqs = t.faq.faqs;

/*
 * FAQPage şeması, Google'ın soruları arama sonuçlarında zengin snippet
 * olarak göstermesini sağlar. İçerik, sayfada görünen `faqs` dizisinden
 * üretilir — görünmeyen/uydurma bir soru eklenmez. Dil, sayfanın
 * diline göre otomatik uyar.
 */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: localeTags[getLocale(Astro.url.pathname)],
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.a,
    },
  })),
};
---

{/*
  Akordeon native <details>/<summary> ile kurulu kalır: JS'siz de tamamen
  çalışır ve klavyeyle erişilebilir. Görsel katman cam yüzeye taşındı;
  açık durumda kart altın kenarlıkla vurgulanır.
*/}
<section id="sss" class="section-shell">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="aurora left-1/2 top-[20%] h-[440px] w-[680px] -translate-x-1/2 bg-primary-600/18"
    >
    </div>
  </div>

  <div class="section-body mx-auto max-w-4xl px-24 py-64 lg:px-32 lg:py-96">
    <SectionHeading eyebrow={t.faq.eyebrow} title={t.faq.title} align="center" />

    <div class="mt-48 flex flex-col gap-16">
      {
        faqs.map((faq) => (
          <details
            data-reveal
            class="glass card-spotlight group rounded-xl px-24 py-16 transition-[border-color,box-shadow] duration-500 ease-premium open:border-accent-400/35 open:shadow-[var(--shadow-glow)]"
          >
            <summary class="cursor-pointer list-none font-display text-base font-semibold text-neutral-50 marker:content-none">
              <span class="flex items-center justify-between gap-16">
                {faq.q}
                <span
                  aria-hidden="true"
                  class="grid h-24 w-24 shrink-0 place-items-center rounded-full border border-neutral-50/14 text-accent-300 transition-transform duration-300 ease-premium group-open:rotate-45"
                >
                  +
                </span>
              </span>
            </summary>
            <p class="mt-16 leading-relaxed text-neutral-400">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
