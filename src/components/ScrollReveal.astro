{/*
  data-reveal öğeleri varsayılan olarak tam görünürdür (JS'siz/erişilebilir).
  Yalnızca JS çalışıyorsa VE prefers-reduced-motion kapalıysa, öğeler JS
  tarafından gizlenip IntersectionObserver ile görünüme girince ortaya
  çıkarılır — böylece animasyon bir bağımlılık değil, aşamalı bir katmandır.
*/}
<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const elements = document.querySelectorAll<HTMLElement>("[data-reveal]");

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) {
            entry.target.style.transition = `opacity 600ms var(--ease-premium), transform 600ms var(--ease-premium)`;
            entry.target.style.opacity = "1";
            entry.target.style.transform = "none";
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 }
    );

    elements.forEach((el, index) => {
      el.style.opacity = "0";
      el.style.transform = "translateY(16px)";
      el.style.transitionDelay = `${(index % 4) * 80}ms`;
      observer.observe(el);
    });
  }
</script>
