---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ProblemSection from "../components/sections/ProblemSection.astro";
import ProcessFlow from "../components/sections/ProcessFlow.astro";
import ResultsSection from "../components/sections/ResultsSection.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import WhyCnkr from "../components/sections/WhyCnkr.astro";
import CaseStudies from "../components/sections/CaseStudies.astro";
import Services from "../components/sections/Services.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import FinalCta from "../components/sections/FinalCta.astro";
---

<BaseLayout
  title="Dijital Pazarlama ve Büyüme Sistemleri Kurun"
  description="İşletmeniz için Google Ads, Meta reklam, SEO, web tasarım ve AI otomasyonunu tek bir dijital büyüme sistemine dönüştürüyoruz. Ücretsiz strateji görüşmesi alın."
  altHref="/en/"
>
  <Hero />
  <ProblemSection />
  <ProcessFlow />
  <ResultsSection />
  <Testimonials />
  <AboutMe />
  <WhyCnkr />
  <CaseStudies />
  <Services />
  <FaqSection />
  <FinalCta />
</BaseLayout>
