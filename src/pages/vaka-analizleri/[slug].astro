---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";

export async function getStaticPaths() {
  const cases = await getCollection("case-studies");
  return cases.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<BaseLayout
  title={item.data.client}
  description={`${item.data.client} vaka analizi: problem, çözüm ve sonuçlar.`}
>
  <article class="border-b border-neutral-200 bg-neutral-50">
    <div class="mx-auto max-w-3xl px-24 py-64 lg:px-32 lg:py-96">
      {item.data.isPlaceholder && (
        <Badge class="mb-24">Örnek vaka — gerçek verilerle güncellenecek</Badge>
      )}
      <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">{item.data.industry}</p>
      <h1 class="mt-16 font-display text-3xl font-semibold text-neutral-900 lg:text-4xl">
        {item.data.client}
      </h1>

      <div class="mt-48 flex flex-col gap-32">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Problem</p>
          <p class="mt-8 text-neutral-700">{item.data.problem}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Çözüm</p>
          <p class="mt-8 text-neutral-700">{item.data.solution}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Sonuç</p>
          <p class="mt-8 text-neutral-700">{item.data.results}</p>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
