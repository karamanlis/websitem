---
import SectionHeading from "../ui/SectionHeading.astro";

const traits = [
  { name: "Stratejik düşünce", note: "Taktik önermeden önce işletmenizin büyüme mantığını çözeriz." },
  { name: "Dijital uzmanlık", note: "Web, reklam ve içerik disiplinlerini tek çatı altında yönetiriz." },
  { name: "AI sistemleri uzmanlığı", note: "Otomasyonu bir eklenti değil, sistemin omurgası olarak kurarız." },
  { name: "Dönüşüm odağı", note: "Trafik değil, ölçülebilir iş sonuçları için tasarlarız." },
  { name: "Uzun vadeli büyüme anlayışı", note: "Tek seferlik kampanya değil, sürdürülebilir sistem kurarız." },
];
---

<section id="neden-cnkr" class="border-b border-neutral-200 bg-neutral-50">
  <div class="mx-auto grid max-w-6xl gap-48 px-24 py-64 lg:grid-cols-[0.9fr_1.1fr] lg:px-32 lg:py-96">
    <SectionHeading eyebrow="Neden CNKR?" title="Taktik değil, metodoloji satarız." />

    <ul class="flex flex-col gap-32">
      {traits.map((trait) => (
        <li class="border-l-2 border-primary-600 pl-24">
          <p class="font-display text-lg font-semibold text-neutral-900">{trait.name}</p>
          <p class="mt-8 text-neutral-600">{trait.note}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
