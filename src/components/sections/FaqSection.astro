---
import SectionHeading from "../ui/SectionHeading.astro";

const faqs = [
  {
    q: "Ne kadar reklam bütçesine ihtiyacım var?",
    a: "Bütçe, sektörünüze ve hedeflerinize göre değişir. Strateji görüşmesinde işletmenize uygun gerçekçi bir bütçe aralığını birlikte belirleriz.",
  },
  {
    q: "Bir web sitesi projesi ne kadar sürer?",
    a: "Kapsam ve içerik hazırlığına bağlı olarak değişir; strateji görüşmesinde projenize özel bir zaman çizelgesi paylaşırız.",
  },
  {
    q: "Sonuçları ne zaman görmeye başlarım?",
    a: "Sistem kurulumu ve optimizasyon aşamalarına bağlı olarak değişir; bu, sabit bir vaat değil, işletmenize özel bir süreçtir.",
  },
  {
    q: "Hangi işletmelerle çalışıyorsunuz?",
    a: "Butik oteller, klinikler, fitness merkezleri, koçlar, yerel işletmeler ve hizmet sektöründeki KOBİ'lerle çalışıyoruz.",
  },
  {
    q: "Strateji görüşmesi nasıl işliyor?",
    a: "Görüşmede işletmenizi, mevcut dijital varlığınızı ve hedeflerinizi konuşuyoruz; uygunsa size özel bir sistem önerisi paylaşıyoruz.",
  },
];
---

{/*
  Akordeon native <details>/<summary> ile kurulu kalır: JS'siz de tamamen
  çalışır ve klavyeyle erişilebilir. Görsel katman cam yüzeye taşındı;
  açık durumda kart altın kenarlıkla vurgulanır.
*/}
<section id="sss" class="section-shell">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="aurora left-1/2 top-[20%] h-[440px] w-[680px] -translate-x-1/2 bg-primary-600/18"
    >
    </div>
  </div>

  <div class="section-body mx-auto max-w-4xl px-24 py-64 lg:px-32 lg:py-96">
    <SectionHeading eyebrow="SSS" title="Sıkça sorulan sorular" align="center" />

    <div class="mt-48 flex flex-col gap-16">
      {
        faqs.map((faq) => (
          <details
            data-reveal
            class="glass card-spotlight group rounded-xl px-24 py-16 transition-[border-color,box-shadow] duration-500 ease-premium open:border-accent-400/35 open:shadow-[var(--shadow-glow)]"
          >
            <summary class="cursor-pointer list-none font-display text-base font-semibold text-neutral-50 marker:content-none">
              <span class="flex items-center justify-between gap-16">
                {faq.q}
                <span
                  aria-hidden="true"
                  class="grid h-24 w-24 shrink-0 place-items-center rounded-full border border-neutral-50/14 text-accent-300 transition-transform duration-300 ease-premium group-open:rotate-45"
                >
                  +
                </span>
              </span>
            </summary>
            <p class="mt-16 leading-relaxed text-neutral-400">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
