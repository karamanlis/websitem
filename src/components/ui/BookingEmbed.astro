---
/**
 * Google Calendar randevu takvimini sayfaya gömer.
 *
 * Google'ın "paylaşılabilir bağlantı"sı normalde tam sayfa randevu ekranı
 * açar; `gv=true` parametresi onu gömülebilir görünüme çevirir. Kullanıcı
 * linki nasıl yapıştırırsa yapıştırsın (parametreli/parametresiz) doğru
 * çalışsın diye parametreyi burada normalize ediyoruz.
 *
 * `bookingUrl` boşken hiçbir şey render edilmez — çağıran bileşen kendi
 * yer tutucusunu gösterir.
 */
import { siteConfig } from "../../lib/site-config";

interface Props {
  /** Gömülü takvim yüksekliği; dar bölümlerde düşürülebilir. */
  height?: string;
  class?: string;
}

const { height = "700px", class: className = "" } = Astro.props;

let embedUrl = "";
if (siteConfig.bookingUrl) {
  try {
    const url = new URL(siteConfig.bookingUrl);
    url.searchParams.set("gv", "true");
    embedUrl = url.toString();
  } catch {
    // Geçersiz URL yapıştırıldıysa siteyi çökertmek yerine sessizce
    // yer tutucuya düşüyoruz.
    embedUrl = "";
  }
}
---

{
  embedUrl && (
    <iframe
      src={embedUrl}
      title="Strateji görüşmesi randevu takvimi"
      style={`height: ${height}`}
      class={`w-full rounded-sm border-0 bg-neutral-50 ${className}`}
      loading="lazy"
    />
  )
}
