---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı.">
  <section class="section-shell">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="aurora left-1/2 top-1/2 h-[460px] w-[620px] -translate-x-1/2 -translate-y-1/2 animate-aurora bg-primary-500/26"
      >
      </div>
      <div class="grid-mask"></div>
    </div>

    <div
      class="section-body mx-auto flex max-w-2xl flex-col items-center gap-24 px-24 py-96 text-center"
    >
      <p
        class="text-sheen font-display text-[clamp(3.5rem,2rem+6vw,6rem)] font-semibold leading-none"
      >
        404
      </p>
      <p class="text-lg text-neutral-400">Aradığınız sayfa bulunamadı.</p>
      <Button href="/" variant="solid" class="mt-16">Ana sayfaya dön</Button>
    </div>
  </section>
</BaseLayout>
