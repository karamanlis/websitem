---
import SectionHeading from "../ui/SectionHeading.astro";
import { getDict } from "../../lib/i18n";

const t = getDict(Astro.url.pathname);
const results = t.results;
---

{/*
  Sonuçlar bölümü — artık sitenin koyu temasıyla tam uyumlu, cam panel
  üzerinde altın vurgulu kartlar. Aurora ve gren ile derinlik kazanır.
*/}
<section id="sonuclar" class="section-shell">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="aurora left-1/2 top-1/2 h-[520px] w-[880px] -translate-x-1/2 -translate-y-1/2 bg-accent-500/16"
    >
    </div>
  </div>

  <div class="section-body mx-auto max-w-6xl px-24 py-64 lg:px-32 lg:py-96">
    <div
      class="glass-deep relative overflow-hidden rounded-3xl px-24 py-64 shadow-[0_40px_100px_-40px_rgba(0,0,0,0.9)] ring-1 ring-neutral-50/8 lg:px-64"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_85%_0%,rgba(212,175,94,0.08),transparent_70%)]"
        >
        </div>
        <div class="noise-layer opacity-[0.08]"></div>
      </div>

      <div class="relative">
        <SectionHeading
          eyebrow={results.eyebrow}
          title={results.title}
          class="max-w-2xl"
        />

        <ul class="mt-48 grid gap-16 lg:grid-cols-2">
          {
            results.items.map((outcome) => (
              <li
                data-reveal
                class="group flex items-start gap-16 rounded-xl border border-neutral-50/8 bg-neutral-50/4 px-24 py-24 shadow-[0_12px_30px_-24px_rgba(0,0,0,0.55)] transition-all duration-500 ease-premium hover:-translate-y-0.5 hover:border-accent-400/30 hover:shadow-[0_20px_44px_-24px_rgba(212,175,94,0.3)]"
              >
                {/* Onay işareti: yeşil gradyan disk */}
                <span
                  aria-hidden="true"
                  class="mt-px grid h-24 w-24 shrink-0 place-items-center rounded-full bg-[linear-gradient(140deg,var(--color-primary-500),var(--color-primary-700))] text-neutral-50 shadow-[0_4px_12px_-4px_rgba(37,107,76,0.8)]"
                >
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 12.5 9.5 18 20 6.5" />
                  </svg>
                </span>
                <p class="text-lg leading-snug text-neutral-200">{outcome}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
