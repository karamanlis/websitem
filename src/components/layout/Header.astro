---
import { siteConfig } from "../../lib/site-config";
import type { Locale } from "../../lib/i18n";
import { getDict } from "../../lib/i18n";
import Button from "../ui/Button.astro";

interface Props {
  locale: Locale;
  /** Bu sayfanın diğer dildeki karşılığı; yoksa dil seçici tek etiket olarak kalır. */
  altHref?: string;
}

const { locale, altHref } = Astro.props;
const { header, nav, ctaLabel } = getDict(Astro.url.pathname);
/** CTA, doğrudan Google Calendar randevu sayfasına gider. */
const ctaHref = siteConfig.bookingUrl || (locale === "en" ? "/en/contact" : "/iletisim");
const ctaTarget = siteConfig.bookingUrl ? "_blank" : undefined;
const switchHref = altHref;
---

{/*
  Sticky başlık iki durumludur:
  - sayfa tepesinde: tamamen saydam, hero'nun atmosferini kesmez
  - kaydırıldığında (`data-scrolled`): cam panel + gradyan saç teli belirir
  Durum, aşağıdaki script tarafından `data-scrolled` özniteliğiyle yazılır;
  JS çalışmazsa başlık cam görünümünde kalır (aşamalı geliştirme).
*/}
<header
  id="site-header"
  class="group/header sticky top-0 z-50 transition-[background-color,backdrop-filter,box-shadow] duration-500 ease-premium data-[scrolled]:bg-surface-950/72 data-[scrolled]:shadow-[0_18px_40px_-30px_rgba(0,0,0,0.95)] data-[scrolled]:backdrop-blur-xl data-[scrolled]:backdrop-saturate-150"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-24 py-16 lg:px-32">
    <a
      href={locale === "en" ? "/en/" : "/"}
      class="group/logo flex items-center gap-16 font-display text-xl font-semibold text-neutral-50"
    >
      {/* Marka işareti: logo görseli, hover'da parlar */}
      <img
        src="/logo-mark.jpg"
        alt=""
        aria-hidden="true"
        width="32"
        height="32"
        class="relative h-32 w-32 rounded-full object-cover shadow-[0_0_20px_-4px_rgba(47,128,96,0.8)] ring-1 ring-neutral-50/15 transition-shadow duration-500 ease-premium group-hover/logo:shadow-[0_0_28px_-2px_rgba(212,175,94,0.7)]"
      />
      <span class="transition-colors duration-300 ease-premium group-hover/logo:text-accent-200">
        {siteConfig.logoText || siteConfig.name}
      </span>
    </a>

    {/*
      Kırılma noktası `lg` değil `xl`: menü öğeleri + CTA butonu + dil
      seçici 1024px'te logoyla çakışıyordu. 1280px altında hamburger
      menüye düşülür.
    */}
    <nav aria-label={locale === "en" ? "Main navigation" : "Ana gezinme"} class="hidden items-center gap-8 xl:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="relative rounded-full px-8 py-8 text-sm font-medium text-neutral-300 transition-colors duration-300 ease-premium hover:bg-neutral-50/6 hover:text-neutral-50"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-16 xl:flex">
      {/* Dil seçici: karşı sayfa varsa tıklanabilir, yoksa yalnızca etiket */}
      <span
        class="flex items-center rounded-full border border-neutral-50/14 bg-neutral-50/5 text-xs font-semibold"
      >
        <span class="rounded-full bg-neutral-50/10 px-10 py-6 text-neutral-50">{header.langLabel}</span>
        {
          switchHref ? (
            <a
              href={switchHref}
              class="rounded-full px-10 py-6 text-neutral-400 transition-colors duration-300 ease-premium hover:text-neutral-50"
              aria-label={header.langSwitchSr}
            >
              {header.langSwitchLabel}
            </a>
          ) : (
            <span class="px-10 py-6 text-neutral-600">{header.langSwitchLabel}</span>
          )
        }
      </span>
      <Button href={ctaHref} variant="solid" target={ctaTarget} class="px-24 py-8 text-sm">
        {ctaLabel}
      </Button>
    </div>

    <div class="flex items-center gap-16 xl:hidden">
      <span
        class="flex items-center rounded-full border border-neutral-50/14 bg-neutral-50/5 text-xs font-semibold"
      >
        <span class="rounded-full bg-neutral-50/10 px-10 py-6 text-neutral-50">{header.langLabel}</span>
        {
          switchHref ? (
            <a
              href={switchHref}
              class="rounded-full px-10 py-6 text-neutral-400 transition-colors duration-300 ease-premium hover:text-neutral-50"
              aria-label={header.langSwitchSr}
            >
              {header.langSwitchLabel}
            </a>
          ) : (
            <span class="px-10 py-6 text-neutral-600">{header.langSwitchLabel}</span>
          )
        }
      </span>

      <button
        id="mobile-nav-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-full border border-neutral-50/14 bg-neutral-50/5 p-8 text-neutral-100 transition-colors duration-300 ease-premium hover:border-accent-400/40 hover:text-neutral-50 xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">{header.menuToggle}</span>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  {/* Sert kenarlık yerine, yalnızca kaydırıldığında beliren gradyan saç teli */}
  <div
    aria-hidden="true"
    class="hairline opacity-0 transition-opacity duration-500 ease-premium group-data-[scrolled]/header:opacity-100"
  >
  </div>

  <nav
    id="mobile-nav"
    aria-label={locale === "en" ? "Mobile navigation" : "Mobil gezinme"}
    class="hidden flex-col gap-8 border-t border-neutral-50/8 bg-surface-950/92 px-24 py-24 backdrop-blur-xl xl:hidden"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-16 py-8 text-base font-medium text-neutral-200 transition-colors duration-300 ease-premium hover:bg-neutral-50/6 hover:text-neutral-50"
        >
          {item.label}
        </a>
      ))
    }
    <Button href={ctaHref} variant="solid" target={ctaTarget} class="mt-8 w-full">
      {ctaLabel}
    </Button>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const nav = document.getElementById("mobile-nav");

  function closeMobileNav() {
    nav?.classList.remove("flex");
    nav?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("flex");
    nav?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  // Menüdeki bir bağlantıya tıklanınca menü kapanmalı; aksi halde açık
  // menü, sticky header'a bağlı kalıp anchor ile kaydırılan hedef bölümün
  // üzerini kaplıyordu.
  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileNav);
  });

  /*
    Kaydırma durumu: sayfa tepesindeyken başlık saydam kalır, ilk 12px'ten
    sonra cam panele döner. rAF ile throttle edilir (scroll'da layout okuma
    maliyetini düşürmek için).
  */
  const header = document.getElementById("site-header");
  let ticking = false;

  function syncHeaderState() {
    if (window.scrollY > 12) {
      header?.setAttribute("data-scrolled", "");
    } else {
      header?.removeAttribute("data-scrolled");
    }
    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(syncHeaderState);
      }
    },
    { passive: true }
  );

  syncHeaderState();
</script>
