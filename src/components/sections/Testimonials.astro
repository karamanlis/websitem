---
/**
 * Sosyal kanıt bölümü.
 *
 * Uydurma görüş kullanılmaz: `siteConfig.testimonials` boşken bu bölüm
 * sayfada hiç render edilmez. İlk görüş "öne çıkan" olarak büyük tipografiyle,
 * kalanlar yanında daha küçük blok olarak dizilir — brief'in "her yerde
 * simetrik grid kullanma" kuralına uygun asimetrik bir düzen.
 */
import SectionHeading from "../ui/SectionHeading.astro";
import { siteConfig, type Testimonial } from "../../lib/site-config";

const testimonials = siteConfig.testimonials;
const [featured, ...rest] = testimonials;

/** Logo yoksa işletme adından monogram üretilir: "Lavinya Çocuk Kulübü" → "LÇ" */
function monogram(t: Testimonial) {
  return t.company
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toLocaleUpperCase("tr-TR") ?? "")
    .join("");
}
---

{
  testimonials.length > 0 && (
    <section id="gorusler" class="border-b border-neutral-200 bg-neutral-50">
      <div class="mx-auto max-w-6xl px-24 py-64 lg:px-32 lg:py-96">
        <SectionHeading
          eyebrow="Müşteri Görüşleri"
          title="Sistemle çalışan işletmeler ne söylüyor?"
          class="max-w-2xl"
        />

        <div class="mt-48 grid gap-48 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
          <figure class="border-l-2 border-accent-500 pl-32">
            {featured.result && (
              <p class="mb-16 text-sm font-semibold uppercase tracking-[0.14em] text-primary-700">
                {featured.result}
              </p>
            )}
            <blockquote class="font-display text-2xl font-semibold leading-[1.35] text-neutral-900 lg:text-3xl">
              {featured.quote}
            </blockquote>
            <figcaption class="mt-32 flex items-center gap-16">
              {featured.logo ? (
                <img
                  src={featured.logo}
                  alt={`${featured.company} logosu`}
                  class="h-48 w-48 shrink-0 rounded-full object-contain"
                  loading="lazy"
                />
              ) : (
                <span
                  class="flex h-48 w-48 shrink-0 items-center justify-center rounded-full bg-primary-900 font-display text-sm font-semibold text-neutral-50"
                  aria-hidden="true"
                >
                  {monogram(featured)}
                </span>
              )}
              <span class="text-sm">
                <span class="block font-semibold text-neutral-900">{featured.company}</span>
                <span class="block text-neutral-600">{featured.sector}</span>
              </span>
            </figcaption>
          </figure>

          {rest.length > 0 && (
            <div class="flex flex-col gap-32 lg:mt-16">
              {rest.map((t) => (
                <figure class="border-t border-neutral-200 pt-24">
                  {t.result && (
                    <p class="mb-8 text-xs font-semibold uppercase tracking-[0.14em] text-primary-700">
                      {t.result}
                    </p>
                  )}
                  <blockquote class="text-lg leading-relaxed text-neutral-800">
                    {t.quote}
                  </blockquote>
                  <figcaption class="mt-16 text-sm">
                    <span class="font-semibold text-neutral-900">{t.company}</span>
                    <span class="text-neutral-600"> — {t.sector}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
