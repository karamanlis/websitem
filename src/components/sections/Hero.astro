---
import Button from "../ui/Button.astro";
import { siteConfig } from "../../lib/site-config";
import { getDict } from "../../lib/i18n";

const t = getDict(Astro.url.pathname);
const hero = t.hero;
---

{/*
  Hero'nun görsel kimliği: sayfa zeminin üzerine binen üç animasyonlu aurora
  lekesi + maskeli ince ızgara + üstten inen spotlight. Tüm bu katmanlar
  dekoratiftir (`aria-hidden`) ve `-z-10` ile içeriğin arkasında durur.
*/}
<section class="section-shell">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    {/* Ana sayfa arka plan videosu (sessiz, döngülü) + okunabilirlik için koyu katman */}
    <video
      class="absolute inset-0 h-full w-full object-cover motion-reduce:hidden"
      src="/hero-video.mp4"
      poster="/hero-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
    </video>
    <img
      src="/hero-poster.jpg"
      alt=""
      class="absolute inset-0 hidden h-full w-full object-cover motion-reduce:block"
    />
    <div class="absolute inset-0 bg-[rgba(5,12,9,0.62)]"></div>

    {/* Üstten inen spotlight */}
    <div
      class="absolute inset-x-0 top-0 h-[70%] bg-[radial-gradient(ellipse_60%_100%_at_50%_0%,rgba(212,175,94,0.10),transparent_70%)]"
    >
    </div>

    {/* Yavaşça sürüklenen ışık lekeleri */}
    <div
      class="aurora left-[-14%] top-[-18%] h-[560px] w-[560px] animate-aurora bg-primary-500/30"
    >
    </div>
    <div
      class="aurora right-[-12%] top-[6%] h-[480px] w-[480px] animate-aurora-slow bg-accent-500/16"
    >
    </div>
    <div
      class="aurora bottom-[-28%] left-[34%] h-[520px] w-[620px] animate-aurora bg-primary-700/34 [animation-delay:-9s]"
    >
    </div>

    <div class="grid-mask"></div>

    {/*
      Alt vinyet: bir sonraki bölüme sert kenarlık olmadan bağlanır.
      Tam opak siyaha inmez — aksi halde hero ile sonraki bölüm arasında
      düz bir siyah bant oluşuyordu.
    */}
    <div
      class="absolute inset-x-0 bottom-0 h-96 bg-[linear-gradient(to_bottom,transparent,rgba(5,12,9,0.6))]"
    >
    </div>
  </div>

  <div
    class="section-body mx-auto max-w-6xl px-24 pb-96 pt-64 lg:px-32 lg:pb-96 lg:pt-96"
  >
    <div class="max-w-2xl">
      <p class="eyebrow">{siteConfig.name}</p>

      <h1
        class="mt-24 font-display text-[clamp(2.25rem,1.2rem+4.4vw,4rem)] font-semibold leading-[1.04] tracking-[-0.025em] text-balance text-neutral-50"
        set:html={hero.titleHtml}
      >
      </h1>

      <p class="mt-32 max-w-lg text-lg leading-relaxed text-neutral-300">
        {hero.paragraph}
      </p>

      <div class="mt-48 flex flex-wrap items-center gap-24">
        <Button href="#iletisim" variant="solid">{t.ctaLabel}</Button>
      </div>

      {
        hero.stats.length > 0 && (
          <dl class="mt-64 grid max-w-lg grid-cols-3 gap-8 border-t border-accent-400/15 pt-24 text-center">
            {hero.stats.map((stat) => (
              /* DOM sırası dt → dd; flex-col-reverse rakamı görsel olarak üste alır. */
              <div class="flex flex-col-reverse">
                <dt class="mt-8 text-xs font-medium uppercase tracking-[0.14em] text-neutral-300">
                  {stat.label}
                </dt>
                <dd class="font-display text-2xl font-semibold tracking-[-0.02em] text-gold lg:text-3xl">
                  {stat.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>
