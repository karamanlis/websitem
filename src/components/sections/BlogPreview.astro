---
import { getCollection } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import { categoryLabels } from "../../content.config";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<section id="blog" class="border-b border-neutral-200 bg-neutral-100">
  <div class="mx-auto max-w-6xl px-24 py-64 lg:px-32 lg:py-96">
    <div class="flex flex-wrap items-end justify-between gap-24">
      <SectionHeading eyebrow="Blog" title="Dijital büyüme üzerine düşünceler." />
      <Button href="/blog" variant="outline">Tüm yazılar</Button>
    </div>

    <div class="mt-48 grid gap-32 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="flex flex-col gap-16 rounded-sm border border-neutral-200 bg-neutral-50 p-24 transition-colors duration-250 ease-premium hover:border-primary-600"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">
            {categoryLabels[post.data.category]}
          </p>
          <p class="font-display text-lg font-semibold text-neutral-900">{post.data.title}</p>
          <p class="text-sm text-neutral-600">{post.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
