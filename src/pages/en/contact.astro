---
/**
 * English contact page.
 *
 * Turkish page: /iletisim. Netlify Forms'a ayrı bir isimle
 * ("iletisim-en") kaydedilir — iki formun gönderileri panelde
 * ayrı ayrı izlenir.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { siteConfig } from "../../lib/site-config";
import { getDict } from "../../lib/i18n";

const { ctaLabel } = getDict(Astro.url.pathname);

const fieldClass =
  "w-full rounded-xl border border-neutral-50/12 bg-neutral-50/4 px-24 py-16 text-[15px] text-neutral-100 transition-[border-color,box-shadow,background-color] duration-300 ease-premium placeholder:text-neutral-500 hover:border-neutral-50/20 focus:border-accent-400/50 focus:bg-neutral-50/6 focus:shadow-[0_0_0_4px_rgba(212,175,94,0.10)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-400";
const labelClass = "mb-8 block text-sm font-semibold text-neutral-200";
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${siteConfig.name}: book a free strategy call or tell us about your project.`}
  altHref="/iletisim"
>
  <section class="section-shell">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="aurora left-[-12%] top-[-12%] h-[520px] w-[560px] animate-aurora bg-primary-500/24"
      >
      </div>
      <div
        class="aurora right-[-10%] top-[18%] h-[420px] w-[480px] bg-accent-600/14"
      >
      </div>
      <div class="grid-mask"></div>
    </div>

    <div class="section-body mx-auto max-w-6xl px-24 py-64 lg:px-32 lg:py-96">
      <SectionHeading
        eyebrow="Contact"
        title="Let's listen to your business first, then talk about the system."
        sheen
        class="max-w-2xl"
      >
        <p class="mt-32 max-w-xl text-lg leading-relaxed text-neutral-400">
          The fastest way is to pick a time that suits you from the calendar.
          If you can't find a suitable slot, fill out the form — we reply
          within 1 business day.
        </p>
      </SectionHeading>

      <div class="mt-64 grid gap-48 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div class="glass-deep rounded-3xl p-32 lg:p-48">
          <h2 class="font-display text-xl font-semibold text-neutral-50">
            Tell us about your project
          </h2>

          <form
            name="iletisim-en"
            method="POST"
            action="/en/thank-you/"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            class="mt-32 flex flex-col gap-24"
          >
            {/* Netlify'ın formu eşleştirmesi için zorunlu gizli alan */}
            <input type="hidden" name="form-name" value="iletisim-en" />
            {/* Bot tuzağı: gerçek kullanıcılar bu alanı görmez ve doldurmaz */}
            <p class="hidden">
              <label>
                Leave this field empty: <input name="bot-field" tabindex="-1" />
              </label>
            </p>

            <div>
              <label class={labelClass} for="ad">Full name</label>
              <input
                class={fieldClass}
                type="text"
                id="ad"
                name="ad"
                required
                autocomplete="name"
              />
            </div>

            <div>
              <label class={labelClass} for="isletme">Business name</label>
              <input
                class={fieldClass}
                type="text"
                id="isletme"
                name="isletme"
                autocomplete="organization"
              />
            </div>

            <div class="grid gap-24 sm:grid-cols-2">
              <div>
                <label class={labelClass} for="email">Email</label>
                <input
                  class={fieldClass}
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                />
              </div>
              <div>
                <label class={labelClass} for="telefon">Phone</label>
                <input
                  class={fieldClass}
                  type="tel"
                  id="telefon"
                  name="telefon"
                  autocomplete="tel"
                />
              </div>
            </div>

            <div>
              <label class={labelClass} for="mesaj">
                What is holding you back the most right now?
              </label>
              <textarea
                class={fieldClass}
                id="mesaj"
                name="mesaj"
                rows="5"
                required
                placeholder="E.g.: We have a website but nobody fills out the form; our Meta ads are running at a costly rate."
              ></textarea>
            </div>

            <div class="flex items-start gap-16">
              <input
                type="checkbox"
                id="kvkk"
                name="kvkk"
                required
                class="mt-8 h-16 w-16 shrink-0 accent-primary-500 focus-visible:outline-2 focus-visible:outline-offset-2"
              />
              <label for="kvkk" class="text-sm text-neutral-400">
                I consent to the processing of my personal data under the
                <a
                  href="/en/privacy-policy"
                  class="font-semibold text-accent-300 underline underline-offset-4 transition-colors duration-300 ease-premium hover:text-accent-200"
                >
                  Privacy Policy
                </a>.
              </label>
            </div>

            {/*
              Buton bileşeni bir <a> render ettiği için form gönderimi
              burada native <button type="submit"> ile kalır; stiller
              Button.astro'nun `solid` varyantıyla birebir eşlenir.
            */}
            <button
              type="submit"
              class="group relative inline-flex items-center justify-center gap-8 self-start overflow-hidden rounded-full bg-primary-600 bg-[linear-gradient(140deg,var(--color-primary-500),var(--color-primary-700))] px-32 py-16 font-body text-[15px] font-semibold tracking-wide text-neutral-50 shadow-[0_10px_30px_-12px_rgba(37,107,76,0.9)] ring-1 ring-inset ring-neutral-50/12 transition-[transform,box-shadow,border-color] duration-300 ease-premium hover:-translate-y-0.5 hover:shadow-[0_18px_45px_-14px_rgba(47,128,96,0.95)] hover:ring-accent-400/40 active:translate-y-0 focus-visible:outline-2"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 -translate-x-full bg-[linear-gradient(105deg,transparent,rgba(255,255,255,0.28),transparent)] transition-transform duration-700 ease-premium group-hover:translate-x-full motion-reduce:hidden"
              ></span>
              <span class="relative">Send message</span>
            </button>
          </form>

          {
            (siteConfig.contactEmail ||
              siteConfig.contactPhone ||
              siteConfig.whatsappNumber) && (
              <div class="mt-48">
                <div aria-hidden="true" class="hairline mb-32 opacity-60"></div>
                <p class="eyebrow">Reach us directly</p>
                <ul class="mt-24 flex flex-col gap-16 text-neutral-300">
                  {siteConfig.contactEmail && (
                    <li>
                      <a
                        href={`mailto:${siteConfig.contactEmail}`}
                        class="transition-colors duration-300 ease-premium hover:text-accent-200"
                      >
                        {siteConfig.contactEmail}
                      </a>
                    </li>
                  )}
                  {siteConfig.contactPhone && (
                    <li>
                      <a
                        href={`tel:${siteConfig.contactPhone.replace(/\s/g, "")}`}
                        class="transition-colors duration-300 ease-premium hover:text-accent-200"
                      >
                        {siteConfig.contactPhone}
                      </a>
                    </li>
                  )}
                  {siteConfig.whatsappNumber && (
                    <li>
                      <a
                        href={`https://wa.me/${siteConfig.whatsappNumber}`}
                        class="transition-colors duration-300 ease-premium hover:text-accent-200"
                        rel="noopener"
                      >
                        Message us on WhatsApp
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            )
          }
        </div>

        {/* Birincil eylem paneli: sayfanın en parlak yüzeyi, formdan önce okunur */}
        <div
          class="glass relative overflow-hidden rounded-3xl p-32 lg:sticky lg:top-96 lg:p-48"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10"
          >
            <div
              class="aurora left-1/2 top-[-30%] h-[320px] w-[420px] -translate-x-1/2 animate-glow-pulse bg-primary-400/35"
            >
            </div>
          </div>

          <h2 class="font-display text-xl font-semibold text-neutral-50">
            {ctaLabel}
          </h2>
          <p class="mt-16 leading-relaxed text-neutral-400">
            30 minutes, not a sales pitch: we review your current situation
            and draw up a concrete roadmap.
          </p>

          <div class="mt-32 flex flex-col items-start gap-16">
            <Button
              href={siteConfig.bookingUrl || `mailto:${siteConfig.contactEmail}`}
              target={siteConfig.bookingUrl ? "_blank" : undefined}
            >
              {ctaLabel}
            </Button>

            <p class="text-sm text-neutral-500">
              Pick a time that suits you from the calendar — it opens in a new tab.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
