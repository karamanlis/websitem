---
interface Props {
  href: string;
  /** `onDark`: primary-900 gibi koyu zeminlerde kullanılan ters kontrast. */
  variant?: "solid" | "outline" | "onDark";
  /** Dış bağlantılar için "_blank"; rel otomatik olarak güvenli hale gelir. */
  target?: string;
  class?: string;
}

const { href, variant = "solid", target, class: className = "" } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-8 rounded-sm px-24 py-16 font-body text-[15px] font-semibold tracking-wide transition-colors duration-250 ease-premium focus-visible:outline-2 focus-visible:outline-offset-2";

const variants = {
  solid:
    "bg-primary-600 text-neutral-50 hover:bg-primary-700",
  outline:
    "border border-neutral-900/20 text-neutral-900 hover:border-primary-600 hover:text-primary-700",
  // Koyu zeminde beyaz buton: primary-900 üzerinde 14.2:1 kontrast.
  onDark:
    "bg-neutral-50 text-primary-900 hover:bg-accent-500 hover:text-neutral-900 focus-visible:outline-neutral-50",
};
---

<a
  href={href}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
  class={`${base} ${variants[variant]} ${className}`}
>
  <slot />
</a>
