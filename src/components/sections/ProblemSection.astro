---
import SectionHeading from "../ui/SectionHeading.astro";
import { getDict } from "../../lib/i18n";

const t = getDict(Astro.url.pathname);
const problems = t.problem;
---

{/*
  Bölümün görsel kimliği: sağ üstte sıcak altın leke + gren dokusu.
  Problem cümleleri düz liste yerine, hover'da soldan aydınlanan cam
  satırlar olarak dizilir.
*/}
<section id="problem" class="section-shell">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="aurora right-[-10%] top-[-10%] h-[420px] w-[520px] bg-accent-600/14"
    >
    </div>
    <div class="noise-layer"></div>
  </div>

  <div
    class="section-body mx-auto grid max-w-6xl gap-48 px-24 py-64 lg:grid-cols-[0.9fr_1.1fr] lg:px-32 lg:py-96"
  >
    <SectionHeading
      eyebrow={problems.eyebrow}
      title={problems.title}
    />

    <ul class="flex flex-col gap-16">
      {
        problems.items.map((problem) => (
          <li
            data-reveal
            class="glass card-lift card-spotlight group flex items-start gap-16 rounded-xl px-24 py-24"
          >
            {/* Sol kenarda altın vurgu çizgisi — hover'da uzar */}
            <span
              aria-hidden="true"
              class="mt-8 h-8 w-8 shrink-0 rounded-full bg-accent-400 shadow-[0_0_12px_2px_rgba(212,175,94,0.5)] transition-transform duration-500 ease-premium group-hover:scale-125"
            />
            <p class="text-lg leading-snug text-neutral-200">{problem}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
