---
import SectionHeading from "../ui/SectionHeading.astro";

const pillars = [
  { name: "Web Siteleri", note: "Dönüşüm için tasarlanmış dijital merkez.", offset: "lg:mt-16" },
  { name: "Reklam Sistemleri", note: "Karlılığa göre optimize edilmiş edinim.", offset: "lg:mt-48" },
  { name: "AI Otomasyon Sistemleri", note: "Operasyonu ölçeklendiren süreçler.", offset: "lg:mt-8" },
  { name: "Dönüşüm Optimizasyonu", note: "Her ziyaretçiden daha fazla değer.", offset: "lg:mt-32" },
];
---

<section id="sistem" class="border-b border-neutral-200 bg-neutral-50">
  <div class="mx-auto max-w-6xl px-24 py-64 lg:px-32 lg:py-96">
    <SectionHeading
      eyebrow="Metodoloji"
      title="Dört bileşen, tek sistem olarak çalışır."
      align="center"
      class="mx-auto max-w-2xl"
    />

    <div class="mt-64 flex flex-col items-center">
      <div class="rounded-sm border border-primary-600 bg-primary-900 px-32 py-16 text-center font-display font-semibold text-neutral-50">
        CNKR Büyüme Sistemi
      </div>

      <div class="relative mt-48 hidden w-full lg:block">
        <div class="absolute inset-x-0 top-0 h-px bg-primary-300" aria-hidden="true"></div>
        <div class="grid grid-cols-4 gap-32">
          {pillars.map((pillar) => (
            <div class={`flex flex-col items-center text-center ${pillar.offset}`}>
              <div class="h-32 w-px bg-primary-300" aria-hidden="true"></div>
              <div data-reveal class="rounded-sm border border-neutral-200 bg-neutral-50 px-24 py-24 shadow-[0_16px_32px_-20px_rgba(14,42,31,0.4)]">
                <p class="font-display text-lg font-semibold text-neutral-900">{pillar.name}</p>
                <p class="mt-8 text-sm text-neutral-600">{pillar.note}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <ol class="mt-48 flex w-full flex-col gap-24 border-l-2 border-primary-300 pl-24 lg:hidden">
        {pillars.map((pillar) => (
          <li>
            <p class="font-display text-lg font-semibold text-neutral-900">{pillar.name}</p>
            <p class="mt-8 text-sm text-neutral-600">{pillar.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
