---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { categoryLabels } from "../../content.config";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const categories = Object.entries(categoryLabels);
---

<BaseLayout
  title="Blog"
  description="Dijital pazarlama, reklam sistemleri, SEO, AI otomasyonu ve dönüşüm optimizasyonu üzerine yazılar."
>
  <section class="section-shell">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="aurora left-[-10%] top-[-10%] h-[500px] w-[560px] animate-aurora bg-primary-500/22"
      >
      </div>
      <div
        class="aurora right-[-8%] top-[14%] h-[380px] w-[460px] bg-accent-600/14"
      >
      </div>
      <div class="dot-mask"></div>
    </div>

    <div class="section-body mx-auto max-w-6xl px-24 py-64 lg:px-32 lg:py-96">
      <SectionHeading
        eyebrow="Blog"
        title="Dijital büyüme üzerine düşünceler."
        sheen
      />

      <div class="mt-48 flex flex-wrap gap-8">
        {categories.map(([slug, label]) => (
          <a
            href={`/blog/kategori/${slug}`}
            class="rounded-full border border-neutral-50/12 bg-neutral-50/4 px-16 py-8 text-sm font-medium text-neutral-300 transition-all duration-300 ease-premium hover:-translate-y-0.5 hover:border-accent-400/40 hover:text-neutral-50"
          >
            {label}
          </a>
        ))}
      </div>

      <div class="mt-48 grid gap-24 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            data-reveal
            class="glass card-lift card-spotlight group flex flex-col gap-16 rounded-2xl p-32"
          >
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-300">
              {categoryLabels[post.data.category]}
            </p>
            <p class="font-display text-lg font-semibold leading-snug text-neutral-50">
              {post.data.title}
            </p>
            <p class="text-sm leading-relaxed text-neutral-400">
              {post.data.description}
            </p>
            <span
              aria-hidden="true"
              class="mt-8 text-lg text-neutral-500 transition-all duration-300 ease-premium group-hover:translate-x-1 group-hover:text-accent-300"
            >
              →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
