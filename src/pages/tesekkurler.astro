---
/**
 * Form gönderimi sonrası teşekkür sayfası (Netlify form `action` hedefi).
 * `noindex` verildi — arama sonuçlarında görünmesi anlamsız ve
 * dönüşüm ölçümünü kirletir.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import { siteConfig } from "../lib/site-config";
import { getDict } from "../lib/i18n";

const { ctaLabel } = getDict(Astro.url.pathname);
---

<BaseLayout
  title="Mesajınız ulaştı"
  description="Mesajınız bize ulaştı. En kısa sürede dönüş yapacağız."
  noindex
  altHref="/en/thank-you"
>
  {/*
    Meta Pixel dönüşüm event'i. Bu sayfa yalnızca form başarıyla
    gönderildikten sonra açıldığı için `Lead` burada tetiklenir —
    böylece başarısız gönderimler dönüşüm sayılmaz. `fbq` base kodu
    BaseLayout'un head'inde senkron tanımlandığı için burada hazırdır.
  */}
  <script is:inline>
    if (typeof fbq === "function") fbq("track", "Lead");
  </script>

  <section class="section-shell">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="aurora left-1/2 top-[30%] h-[440px] w-[640px] -translate-x-1/2 animate-aurora bg-primary-500/28"
      >
      </div>
      <div
        class="aurora left-1/2 top-[52%] h-[240px] w-[420px] -translate-x-1/2 animate-glow-pulse bg-accent-500/20"
      >
      </div>
      <div class="grid-mask"></div>
    </div>

    <div class="section-body mx-auto max-w-2xl px-24 py-96 text-center lg:px-32">
      <p class="eyebrow">Teşekkürler</p>

      <h1
        class="text-sheen mt-24 font-display text-[clamp(1.875rem,1.1rem+3.2vw,3rem)] font-semibold leading-[1.08] tracking-[-0.02em]"
      >
        Mesajınız bize ulaştı.
      </h1>

      <p class="mx-auto mt-32 max-w-lg text-lg leading-relaxed text-neutral-400">
        1 iş günü içinde size dönüş yapacağız. Beklemek istemiyorsanız
        takvimden doğrudan uygun bir saat seçebilirsiniz.
      </p>

      <div class="mt-48 flex flex-wrap items-center justify-center gap-24">
        <Button href={siteConfig.bookingUrl || "/iletisim"} variant="solid">
          {ctaLabel}
        </Button>
        <a
          href="/"
          class="group inline-flex items-center gap-8 text-sm font-semibold text-neutral-300 transition-colors duration-300 ease-premium hover:text-accent-200"
        >
          Ana sayfaya dön
          <span
            aria-hidden="true"
            class="transition-transform duration-300 ease-premium group-hover:translate-x-1"
            >→</span
          >
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
